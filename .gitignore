# Local dev/demo workspace (collections, environments) — live data that
# gets edited/exercised by hand and by scripts/test_control_api.py, not
# project source. workspace/.gitignore's *.local.json rule is now
# redundant (nothing under here is tracked at all) but left in place —
# still-useful documentation of the secrets-overlay convention even
# though git no longer looks at it. The wildcard also covers ad hoc
# folders like workspace2/ from manually testing "open a different
# workspace folder" (Settings > Workspace > Change…).
/workspace*/

# Python bytecode cache (scripts/test_control_api.py)
__pycache__/

# Binaries
/bin/
/cmd/freeman/build/bin/

# Go build/test artifacts
*.test
*.out
/vendor/

# Frontend build artifacts (regenerated by npm/wails — see build.sh)
/cmd/freeman/frontend/node_modules/
/cmd/freeman/frontend/dist/
/cmd/freeman/frontend/dist-web/
/cmd/freeman/frontend/package.json.md5

# Environment files
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/*
!.vscode/launch.json
.idea/
