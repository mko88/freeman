{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "baseUrl": ".",
    // svelte-check has no notion of vite's --mode, so it always resolves
    // $backend to the Wails variant — fine for type-checking, because
    // src/backend.contract.ts asserts that backend.http.ts has the exact
    // same exported signatures. Without that assertion this resolution
    // would quietly leave the HTTP implementation unchecked.
    "paths": {
      "$backend": ["src/backend.wails.ts"]
    },
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
